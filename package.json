{
  "name": "quest-log",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "app",
    "server"
  ],
  "scripts": {
    "schema:gen": "node shared/scripts/gen.mjs",
    "schema:check": "node shared/scripts/gen.mjs --check",
    "skill:version": "node shared/scripts/skill-version.mjs --bump",
    "skill:check": "node shared/scripts/skill-version.mjs --check",
    "validate": "tsx shared/scripts/validate-data.ts",
    "test": "vitest run",
    "typecheck": "tsc -p shared && tsc -p app && tsc -p server && tsc -p worker && tsc -p e2e",
    "dev": "npm run dev -w app",
    "dev:server": "npm run dev -w server",
    "build:pages": "npm run build:pages -w app",
    "build:local": "npm run build:local -w app",
    "format:data": "tsx shared/scripts/format-data.ts",
    "format:data:check": "tsx shared/scripts/format-data.ts --check",
    "e2e:build": "VITE_E2E=1 VITE_GA_ID= VITE_AUTH_URL=https://auth.quest.test VITE_GITHUB_APP_CLIENT_ID=Iv23e2e VITE_GITHUB_APP_SLUG=quest-log-e2e npm run build:pages -w app -- --outDir dist-e2e-pages && VITE_E2E=1 VITE_GA_ID= npm run build:local -w app -- --outDir dist-e2e-local",
    "e2e": "npm run e2e:build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "json-schema-to-typescript": "^15.0.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
