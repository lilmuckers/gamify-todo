{
  "$schema": "../../schema/quest.schema.json",
  "id": "publishing",
  "name": "Publishing",
  "description": "Get the state onto GitHub Pages and edit it locally.",
  "theme": "sky",
  "goalIds": ["ship-v1"],
  "unlocksAfter": ["foundations"],
  "levels": [
    {
      "id": "pages",
      "name": "GitHub Pages",
      "deliverable": "Read-only site deployed from main",
      "timeboxDays": 2,
      "successCriteria": [
        { "id": "deployed", "text": "Site live at the Pages URL", "mvp": true, "done": false }
      ],
      "items": [
        { "id": "workflow", "type": "task", "title": "Pages workflow", "status": "todo" },
        { "id": "enable-pages", "type": "blocker", "title": "Enable Pages in repo settings", "status": "todo" }
      ]
    },
    {
      "id": "docker-edit",
      "name": "Docker Editor",
      "deliverable": "Local container that edits and commits data",
      "timeboxDays": 4,
      "successCriteria": [
        { "id": "commits", "text": "Edits produce a git commit", "mvp": true, "done": false },
        { "id": "pr-review", "text": "Open PRs show as warp worlds", "mvp": false, "done": false }
      ],
      "items": [
        { "id": "api", "type": "task", "title": "REST API", "status": "todo" },
        { "id": "git", "type": "task", "title": "Git commit + push", "status": "todo", "dependsOn": ["api"] },
        { "id": "ssh-mount", "type": "risk", "title": "SSH keys in container", "status": "todo" }
      ]
    }
  ]
}
